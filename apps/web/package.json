{
  "name": "@troll/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "lint": "echo 'lint: reserved for later'"
